# ==============================================================================
# CampusConnect MERN Stack Environment Configuration
# ==============================================================================

# Backend Express Port
PORT=5000

# MongoDB Connection String (Defaults to local MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# Optional: Supabase Credentials (if hybrid auth or storage is desired)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
